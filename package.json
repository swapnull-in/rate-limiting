{
  "name": "rate-limiting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Learn rate limiting in TypeScript — fixed/sliding windows, token bucket, and distributed atomic limiting on Redis.",
  "scripts": {
    "phase1": "node src/phase1/fixed-window.ts",
    "phase2": "node src/phase2/token-bucket.ts",
    "phase3": "node src/phase3/sliding-log.ts",
    "phase4": "node src/phase4/sliding-counter.ts",
    "phase5": "node src/phase5/distributed.ts",
    "phase6": "node src/phase6/leaky-gcra.ts",
    "phase7": "node src/phase7/distributed-strategies.ts",
    "phase8": "node src/phase8/fail-open-closed.ts",
    "phase9": "node src/phase9/retry-storm.ts",
    "phase10": "node src/phase10/concurrency-limit.ts",
    "phase11": "node src/phase11/layered-limits.ts",
    "web": "node web/serve.mjs",
    "deploy": "npx wrangler pages deploy web --project-name rate-limiting",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": { "typescript": "^5.7.0", "@types/node": "^22.10.0" },
  "dependencies": { "ioredis": "^5.11.1" }
}
